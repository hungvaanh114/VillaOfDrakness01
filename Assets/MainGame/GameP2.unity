--- !u!114 &572023670
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 572023668}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "      T\xF4i vi\u1EBFt nh\u1EEFng d\xF2ng n\xE0y ph\xF2ng khi c\xF3 ng\xE0y
    kh\xF4ng c\xF2n ai nghe t\xF4i n\xF3i \u0111\u01B0\u1EE3c n\u1EEFa. Con Linh
    s\u1EE3 c\xE1i gi\u1EBFng sau v\u01B0\u1EDDn t\u1EEB d\u1EA1o h\xE8 n\u0103m
    ngo\xE1i, t\xF4i c\u0169ng kh\xF4ng tr\xE1ch n\xF3 - ch\xEDnh t\xF4i c\u0169ng
    kh\xF4ng d\xE1m nh\xECn xu\u1ED1ng \u0111\xF3 l\xE2u. T\xF4i \u0111\xE3 h\u1ECDc
    \u0111\u01B0\u1EE3c m\u1ED9t \u0111i\u1EC1u l\u1EA1: m\u1ECDi m\u1EB7t n\u01B0\u1EDBc
    trong nh\xE0 n\xE0y, h\u1EC5 \u0111\u1EC3 y\xEAn qu\xE1 l\xE2u kh\xF4ng ai \u0111\u1ED9ng
    t\u1EDBi, \u0111\u1EC1u b\u1EAFt \u0111\u1EA7u \"nh\xECn l\u1EA1i\" m\xECnh.
    T\xF4i ph\u1EE7 v\u1EA3i l\xEAn h\u1EBFt nh\u1EEFng t\u1EA5m g\u01B0\u01A1ng
    t\xF4i t\xECm \u0111\u01B0\u1EE3c - tr\u1EEB m\u1ED9t t\u1EA5m t\xF4i gi\u1EA5u
    k\u1EF9, ph\xF2ng khi c\u1EA7n d\xF9ng t\u1EDBi sau n\xE0y. T\xF4i nh\u1EADn
    ra m\u1ED9t \u0111i\u1EC1u bu\u1ED3n c\u01B0\u1EDDi: trong nh\xE0 n\xE0y, ch\u1ED7
    duy nh\u1EA5t ng\u1ECDn n\u1EBFn kh\xF4ng bao gi\u1EDD lay - d\xF9 c\u1EEDa s\u1ED5
    kh\xE9p h\u1EDD, d\xF9 gi\xF3 v\u1EABn l\xF9a kh\u1EAFp c\xE1c ph\xF2ng kh\xE1c
    - l\xE0 ph\xF2ng c\u1EE7a con Linh. T\xF4i v\u1EABn t\u1EF1 h\u1ECFi t\u1EA1i
    sao. C\xF3 l\u1EBD v\xEC con b\xE9 qu\xE1 quen thu\u1ED9c v\u1EDBi ng\xF4i nh\xE0
    n\xE0y, \u0111\u1EBFn m\u1EE9c ch\xEDnh kh\xF4ng kh\xED trong ph\xF2ng n\xF3
    c\u0169ng \"bi\u1EBFt\" ph\u1EA3i y\xEAn l\u1EB7ng.\r\n      N\u1EBFu c\xF3 ai
    \u0111\u1ECDc \u0111\u01B0\u1EE3c nh\u1EEFng d\xF2ng n\xE0y sau t\xF4i - xin
    t\xECm t\u1EDBi ph\xF2ng con Linh tr\u01B0\u1EDBc. \u0110\u1EEBng v\u1ED9i \u0111i
    th\u1EB3ng ra s\xE2n sau. Gi\xF3 kh\xF4ng \u0111\u1ED5i h\u01B0\u1EDBng \u1EDF
    \u0111\xF3 l\xE0 v\xEC c\xF3 th\u1EE9 g\xEC che ch\u1EAFn n\xF3 kh\u1ECFi m\u1ECDi
    lu\u1ED3ng kh\xED trong nh\xE0 - t\xF4i tin \u0111\xF3 ch\xEDnh l\xE0 n\u01A1i
    an to\xE0n nh\u1EA5t c\xF2n s\xF3t l\u1EA1i. T\xF4i \u0111\xE3 gi\u1EA5u m\u1ED9t
    v\u1EADt \u1EDF \u0111\xF3. Xin \u0111\u1EEBng \u0111\u1EC3 n\xF3 r\u01A1i v\xE0o
    tay k\u1EBB kh\xF4ng hi\u1EC3u gi\xE1 tr\u1ECB th\u1EADt c\u1EE7a n\xF3.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c5dfaa6b020f96f4d8bf246853d20383, type: 2}
