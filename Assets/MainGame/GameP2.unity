  m_Script: {fileID: 11500000, guid: 583d4ac3c95f6654ba27edf944d15cb1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutSceneSequence
  cutSceneId: intro
  playOnce: 1
  teleportToStartPoint: 1
  teleportCameraToFirstShot: 1
  startPoint: {fileID: 564442682}
  points:
  - name: Walk from forest to gate
    point: {fileID: 2134968814}
    moveToPoint: 1
    moveSpeedOverride: -1
    turnSpeedOverride: -1
    dialogueId: intro_gate_arrival
    overrideText: "\u0110\u01B0\u1EDDng m\xF2n v\xE0o bi\u1EC7t th\u1EF1 hi\u1EC7n
      r\xF5 d\u01B0\u1EDBi b\u1EA7u tr\u1EDDi x\xE1m \u0111\u1EE5c. Ng\u1ECDc \u0111i
      ch\u1EADm, m\u1ED9t tay c\u1EA7m \u0111\xE8n d\u1EA7u, tay kia gi\u1EEF cu\u1ED1n
      s\u1ED5 c\u0169 c\u1EE7a b\xE0."
    overrideAudioClip: {fileID: 0}
    overrideFallbackDuration: 0.5
    waitAfter: 0
    cameraShot: 0
    cameraPositionOverride: {fileID: 0}
    cameraLookAtOverride: {fileID: 0}
    cameraLookAtPlayer: 1
    cameraLookHeight: 1.35
    cameraSmoothTimeOverride: -1
    useCustomCameraOffset: 0
    customCameraOffset: {x: 0.45, y: 2.1, z: -3.2}
  - name: Stop at gate
    point: {fileID: 2134968814}
    moveToPoint: 0
    moveSpeedOverride: -1
    turnSpeedOverride: -1
    dialogueId: p2_ngoc_01
    overrideText: "\"B\xE0 \u01A1i, con \u0111\xE3 \u0111\u1EBFn r\u1ED3i.\""
    overrideAudioClip: {fileID: 8300000, guid: c303da944d1f61f449bc1bd1cd76ddc8, type: 3}
    overrideFallbackDuration: 0.5
    waitAfter: 0
    cameraShot: 1
    cameraPositionOverride: {fileID: 0}
    cameraLookAtOverride: {fileID: 0}
    cameraLookAtPlayer: 1
    cameraLookHeight: 1.35
    cameraSmoothTimeOverride: -1
    useCustomCameraOffset: 0
    customCameraOffset: {x: 0.45, y: 2.1, z: -3.2}
  - name: Remember grandmother note
    point: {fileID: 2134968814}
    moveToPoint: 0
    moveSpeedOverride: -1
    turnSpeedOverride: -1
    dialogueId: p2_ngoc_02
    overrideText: "\"B\xE0 n\xF3i c\u0103n nh\xE0 n\xE0y gi\u1EEF th\u1EE9 c\xF3
      th\u1EC3 c\u1EE9u h\u1ECD. Con kh\xF4ng hi\u1EC3u h\u1EBFt, nh\u01B0ng con
      tin b\xE0.\""
    overrideAudioClip: {fileID: 8300000, guid: 9933ce3575c905d40bd64188edfc18a0, type: 3}
    overrideFallbackDuration: 0.5
    waitAfter: 0
    cameraShot: 2
    cameraPositionOverride: {fileID: 0}
    cameraLookAtOverride: {fileID: 0}
    cameraLookAtPlayer: 1
    cameraLookHeight: 1.35
    cameraSmoothTimeOverride: -1
    useCustomCameraOffset: 0
    customCameraOffset: {x: 0.45, y: 2.1, z: -3.2}
  - name: Open front door
    point: {fileID: 1557202579}
    moveToPoint: 1
    moveSpeedOverride: -1
    turnSpeedOverride: -1
    dialogueId: p2_ngoc_03
    overrideText: "\"T\u1EA5m g\u01B0\u01A1ng b\u1EA1c. T\xECm \u0111\u01B0\u1EE3c
      th\xEC \u0111em v\u1EC1. B\xE0 d\u1EB7n... \u0111\u1EEBng nh\xECn v\xE0o m\u1EB7t
      n\u01B0\u1EDBc trong nh\xE0. Tuy\u1EC7t \u0111\u1ED1i kh\xF4ng.\""
    overrideAudioClip: {fileID: 8300000, guid: aabf08c587797194db179da6163e814b, type: 3}
    overrideFallbackDuration: 0.5
    waitAfter: 0
    cameraShot: 3
    cameraPositionOverride: {fileID: 0}
    cameraLookAtOverride: {fileID: 0}
    cameraLookAtPlayer: 1
    cameraLookHeight: 1.35
    cameraSmoothTimeOverride: -1
    useCustomCameraOffset: 0
    customCameraOffset: {x: 0.45, y: 2.1, z: -3.2}
  - name: Enter lobby through front door
    point: {fileID: 1477586545}
    moveToPoint: 1
    moveSpeedOverride: -1
    turnSpeedOverride: -1
    dialogueId: intro_enter_front_door
    overrideText: 
    overrideAudioClip: {fileID: 0}
