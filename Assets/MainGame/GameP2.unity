  showPartTwoContinueButton: 1
  partTwoTransitionSceneName: EndingP2Transition
  endingLine: "VILLA OF DARKNESS\n\nNguy\u1EC5n Minh Khoa d\u1EEBng l\u1EA1i t\u1EA1i
    gi\u1EBFng \u0111\xE1.\nChi\u1EBFc h\u1ED9p nh\u1EA1c \u0111\u1ED3ng n\u1EB1m
    l\u1EA1i,\nCh\u1EDD ng\u01B0\u1EDDi ti\u1EBFp theo b\u01B0\u1EDBc v\xE0o khu
    v\u01B0\u1EDDn n\xE0y.\n\nTH\xC0NH VI\xCAN\n\nNguy\u1EC5n Tr\u01B0\u1EDDng V\u0169\nThi\u1EBFt
    k\u1EBF UI Panels - Thi\u1EBFt k\u1EBF Ambient\n\nV\xF5 V\u0103n Thu\u1EADn\nL\u1EADp
    tr\xECnh Gameplay - H\u1EC7 th\u1ED1ng nh\u1EB7t Item\nC\u01A1 ch\u1EBF Piano
    - C\u01A1 ch\u1EBF Inventory - H\u1EC7 th\u1ED1ng UI\n\nL\xEA Ph\xFA Tu\u1EA5n
    Anh\nLevel Design - Dialogue System\n\nNguy\u1EC5n H\u1EEFu Ph\xFAc\nC\u01A1
    ch\u1EBF s\u1EF1 ki\u1EC7n - Triggers - H\u1EC7 th\u1ED1ng AI\nC\u01A1 ch\u1EBF
    Mirror - Thi\u1EBFt l\u1EADp Animation\n\nNguy\u1EC5n B\xF9i Ph\xFAc Th\xE1i\nBi\xEAn
    k\u1ECBch - C\u1ED1t truy\u1EC7n - PM\nL\u1EADp tr\xECnh Gameplay - Game Design
    Document\nH\u1EC7 th\u1ED1ng Player - Scene Setup\n\nB\xF9i Thanh T\xE2n\nH\u1EC7
    th\u1ED1ng Audio - H\u1EC7 th\u1ED1ng Sanity - L\u1EADp tr\xECnh Gameplay\n\nC\u1EA3m
    \u01A1n b\u1EA1n \u0111\xE3 ch\u01A1i."
